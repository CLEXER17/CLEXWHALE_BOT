# ─────────────────────────────────────────────────────────────
# Hyperliquid Whale Intelligence Bot — configuration example
# Copy to .env for local development. On Railway, set these as
# service variables instead (never commit a real .env).
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=
# Your numeric Telegram user id (see @userinfobot). Highest authority.
MAIN_ADMIN_ID=

# ── Database ────────────────────────────────────────────────
# Railway injects DATABASE_URL for a Postgres service.
# postgres:// and postgresql:// are auto-normalised to asyncpg.
# Local fallback if unset: sqlite+aiosqlite:///./whalebot.db
DATABASE_URL=
# Run Alembic migrations on boot (recommended: true)
RUN_MIGRATIONS=true

# ── Access control ──────────────────────────────────────────
# false = only main admin + co-admins may use the bot
PUBLIC_MODE=false

# ── Whale thresholds (USD) ──────────────────────────────────
# Global default used by every detector unless overridden below.
MIN_WHALE_VALUE=2000000
# Optional per-detector overrides. Leave blank to inherit MIN_WHALE_VALUE.
# MIN_TRADE_VALUE is matched against executed trade value (px * sz).
MIN_TRADE_VALUE=
# MIN_POSITION_VALUE is matched against Hyperliquid's positionValue.
MIN_POSITION_VALUE=
# MIN_ORDER_VALUE is matched against resting order notional (limitPx * sz).
MIN_ORDER_VALUE=
# Position changes are thresholded on the USD delta, not the whole position.
MIN_POSITION_DELTA_VALUE=

# ── Alerting ────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=30
# Max alerts pushed per minute per chat (protects Telegram limits)
ALERT_RATE_PER_MINUTE=20

# ── Coin selection ──────────────────────────────────────────
DEFAULT_COINS=BTC,ETH,SOL
# true = monitor every perp, capped at MAX_MONITORED_COINS by 24h volume
MONITOR_ALL_COINS=false
MAX_MONITORED_COINS=40

# ── Detector toggles ────────────────────────────────────────
ENABLE_TRADE_DETECTOR=true
ENABLE_POSITION_DETECTOR=true
ENABLE_ORDER_DETECTOR=true
ENABLE_ORDER_CANCEL_ALERTS=true
ENABLE_WALLET_TRACKING=true
# Aggregate L2 book scanner: large resting levels WITHOUT wallet attribution
ENABLE_BOOK_SCANNER=false

# ── Hyperliquid API ─────────────────────────────────────────
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# Documented REST budget is 1200 weight/minute per IP. We only spend a
# fraction of it so bursts never trip a 429.
REST_WEIGHT_PER_MINUTE=1200
REST_WEIGHT_SAFETY=0.5
# Documented cap: 10 unique addresses across all user-specific WS subs.
WS_FOCUS_WALLETS=8
# Polling cadences (seconds) for REST enrichment of tracked wallets
POSITION_POLL_INTERVAL=20
ORDER_POLL_INTERVAL=45
BOOK_POLL_INTERVAL=30
# How many wallets stay resident in the tracker (LRU)
WALLET_CACHE_SIZE=400
# Drop a tracked wallet after this many seconds without activity
WALLET_IDLE_TTL=3600

# ── Runtime ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# true = one JSON object per log line (recommended for Railway)
LOG_JSON=false
PORT=8080
